 # DeepSeek API 配置
 DEEPSEEK_API_KEY=your_deepseek_api_key_here
 DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
 
# 可选：留空时，优先使用项目内已下载的 bge-m3；否则首次运行自动下载轻量中文模型。
# 如需指定 Hugging Face SentenceTransformer 模型，可填写模型名。
EMBEDDING_MODEL=
 
 # 向量数据库路径
 CHROMA_PERSIST_DIR=./chroma_db
 
 # FastAPI 服务端口
 API_PORT=8000
